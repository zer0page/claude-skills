#!/usr/bin/env bash

set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
INSTALL="$ROOT/install"
TEST_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/claude-skills-test-XXXXXX")"
trap 'rm -rf "$TEST_ROOT"' EXIT

fail() {
  echo "FAIL: $*" >&2
  exit 1
}

[ "$(find "$ROOT/skills" -mindepth 1 -maxdepth 1 -type d | wc -l | tr -d ' ')" -eq 1 ] ||
  fail "the repository should contain only one skill"
[ -d "$ROOT/skills/audit" ] || fail "audit should be the retained skill"

HOME="$TEST_ROOT/home" "$INSTALL" --skills-only
[ -L "$TEST_ROOT/home/.claude/skills/audit" ] || fail "global audit skill was not linked"
[ ! -e "$TEST_ROOT/home/.claude/settings.json" ] || fail "skills-only modified Claude settings"
[ ! -e "$TEST_ROOT/home/.claude/hooks/tmux-notify.sh" ] || fail "skills-only installed Claude hooks"

ln -s "$ROOT/skills/ci/" "$TEST_ROOT/home/.claude/skills/ci"
HOME="$TEST_ROOT/home" "$INSTALL" --skills-only >/dev/null
[ ! -L "$TEST_ROOT/home/.claude/skills/ci" ] || fail "install left a removed personal skill linked"

PROJECT="$TEST_ROOT/project"
mkdir -p "$PROJECT"
HOME="$TEST_ROOT/home" "$INSTALL" --project "$PROJECT" --skills-only
[ -L "$PROJECT/.claude/skills/audit" ] || fail "project audit skill was not linked"
[ ! -e "$TEST_ROOT/home/.claude/settings.json" ] || fail "project install modified global settings"

output=$(HOME="$TEST_ROOT/home" "$INSTALL" --project "$PROJECT" --skills-only)
case "$output" in
  *"already linked"*) ;;
  *) fail "skills-only reinstall was not idempotent" ;;
esac

HOME="$TEST_ROOT/home" "$INSTALL" --project "$PROJECT" --uninstall
[ ! -L "$PROJECT/.claude/skills/audit" ] || fail "uninstall left the audit symlink"

if HOME="$TEST_ROOT/home" "$INSTALL" --skill ci --skills-only 2>/dev/null; then
  fail "removed ci skill was accepted"
fi
if HOME="$TEST_ROOT/home" "$INSTALL" --bogus 2>/dev/null; then
  fail "unknown option was accepted"
fi

HOOK_HOME="$TEST_ROOT/hook-home"
HOME="$HOOK_HOME" "$INSTALL" </dev/null >/dev/null
[ ! -e "$HOOK_HOME/.claude/settings.json" ] || fail "noninteractive install silently enabled Claude hooks"

mkdir -p "$HOOK_HOME/.claude"
cat >"$HOOK_HOME/.claude/settings.json" <<'EOF'
{"hooks":{"Stop":[{"hooks":[{"type":"command","command":"/usr/local/bin/tmux-notify.sh custom"}]}]}}
EOF
HOME="$HOOK_HOME" "$INSTALL" --tmux-notify 1 >/dev/null
[ -L "$HOOK_HOME/.claude/hooks/tmux-notify.sh" ] || fail "Claude tmux hook was not linked"
if command -v jq >/dev/null; then
  jq -e 'any(.hooks.Stop[].hooks[].command; endswith("tmux-notify.sh notify"))' \
    "$HOOK_HOME/.claude/settings.json" >/dev/null || fail "Claude Stop hook was not configured"
  jq -e '[.hooks.Stop[].hooks[].command] | contains(["/usr/local/bin/tmux-notify.sh custom"])' \
    "$HOOK_HOME/.claude/settings.json" >/dev/null || fail "install removed a user-managed hook"
fi

HOME="$HOOK_HOME" "$INSTALL" --uninstall >/dev/null
[ ! -L "$HOOK_HOME/.claude/hooks/tmux-notify.sh" ] || fail "uninstall left the Claude tmux hook"
if command -v jq >/dev/null; then
  jq -e '.hooks.Stop == [{"hooks":[{"type":"command","command":"/usr/local/bin/tmux-notify.sh custom"}]}]' \
    "$HOOK_HOME/.claude/settings.json" >/dev/null || fail "uninstall did not preserve user-managed hooks"
fi

NO_SETTINGS_HOME="$TEST_ROOT/no-settings-home"
mkdir -p "$NO_SETTINGS_HOME/.claude/hooks"
ln -s "$ROOT/hooks/tmux-notify.sh" "$NO_SETTINGS_HOME/.claude/hooks/tmux-notify.sh"
HOME="$NO_SETTINGS_HOME" "$INSTALL" --tmux-notify 0 >/dev/null
[ ! -L "$NO_SETTINGS_HOME/.claude/hooks/tmux-notify.sh" ] || fail "disable left the Claude tmux hook"
[ ! -e "$NO_SETTINGS_HOME/.claude/settings.json" ] || fail "disable created an empty Claude settings file"

echo "Installer tests passed."
