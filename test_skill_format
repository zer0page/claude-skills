#!/usr/bin/env python3

import re
from pathlib import Path

root = Path(__file__).parent
skills = [path for path in (root / "skills").iterdir() if path.is_dir()]
assert [path.name for path in skills] == ["audit"], "only the portable audit skill should remain"

skill = skills[0]
text = (skill / "SKILL.md").read_text()
assert text.startswith("---\n"), "SKILL.md must start with YAML frontmatter"
_, frontmatter, body = text.split("---", 2)

fields = {}
for line in frontmatter.strip().splitlines():
    key, value = line.split(":", 1)
    fields[key.strip()] = value.strip()

assert fields["name"] == skill.name
assert re.fullmatch(r"[a-z0-9]+(?:-[a-z0-9]+)*", fields["name"])
assert 1 <= len(fields["description"]) <= 1024
assert len(body.splitlines()) < 500

nonportable = (
    "{{SKILL_DIR}}",
    "AskUserQuestion",
    "TeamDelete",
    "EnterWorktree",
    "ExitWorktree",
    "WebFetch",
    "/codex:",
)
for token in nonportable:
    assert token not in body, f"runtime-specific instruction remains: {token}"

print("Skill format tests passed.")
