#!/usr/bin/env bash

set -euo pipefail

REPO_DIR="$(cd "$(dirname "$0")" && pwd)"
SKILLS_SRC="$REPO_DIR/skills"
HOOKS_SRC="$REPO_DIR/hooks"
TARGET_DIR="$HOME/.claude/skills"
HOOKS_DIR="$HOME/.claude/hooks"
SETTINGS_FILE="$HOME/.claude/settings.json"
SKILL_FILTER=""
UNINSTALL=false
SKILLS_ONLY=false
TMUX_NOTIFY=""
PROJECT_INSTALL=false

while [ $# -gt 0 ]; do
  case "$1" in
    --project)
      [ $# -ge 2 ] && [ -n "$2" ] || { echo "Error: --project requires a path" >&2; exit 1; }
      TARGET_DIR="$2/.claude/skills"
      PROJECT_INSTALL=true
      shift 2
      ;;
    --skill)
      [ $# -ge 2 ] && [ -n "$2" ] || { echo "Error: --skill requires a name" >&2; exit 1; }
      SKILL_FILTER="$2"
      shift 2
      ;;
    --skills-only)
      SKILLS_ONLY=true
      shift
      ;;
    --uninstall)
      UNINSTALL=true
      shift
      ;;
    --tmux-notify)
      if [ $# -lt 2 ] || { [ "$2" != 0 ] && [ "$2" != 1 ]; }; then
        echo "Error: --tmux-notify requires 0 or 1" >&2
        exit 1
      fi
      TMUX_NOTIFY="$2"
      shift 2
      ;;
    *)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
  esac
done

if [ -n "$SKILL_FILTER" ] && [ ! -d "$SKILLS_SRC/$SKILL_FILTER" ]; then
  echo "Error: skill '$SKILL_FILTER' not found" >&2
  exit 1
fi

$UNINSTALL || mkdir -p "$TARGET_DIR"
for target in "$TARGET_DIR"/*; do
  [ -L "$target" ] || continue
  source="$(readlink "$target")"
  if [[ "$source" == "$SKILLS_SRC/"* ]] && [ ! -d "$source" ]; then
    rm "$target"
    echo "  removed stale $(basename "$target") link"
  fi
done

for skill_dir in "$SKILLS_SRC"/*/; do
  [ -d "$skill_dir" ] || continue
  name="$(basename "$skill_dir")"
  [ -z "$SKILL_FILTER" ] || [ "$name" = "$SKILL_FILTER" ] || continue
  target="$TARGET_DIR/$name"

  if $UNINSTALL; then
    if [ -L "$target" ] && [[ "$(readlink "$target")" == "$SKILLS_SRC/"* ]]; then
      rm "$target"
      echo "  removed $target"
    fi
  elif [ -L "$target" ] && [ "$(readlink "$target")" = "$skill_dir" ]; then
    echo "  $name (already linked)"
  elif [ -e "$target" ]; then
    echo "  $name: skipped (target already exists)"
  else
    ln -s "$skill_dir" "$target"
    echo "  $name → $skill_dir"
  fi
done

HOOK_TARGET="$HOOKS_DIR/tmux-notify.sh"
if $PROJECT_INSTALL || $SKILLS_ONLY; then
  if $UNINSTALL; then
    echo "done (uninstalled)"
  else
    echo "done (target: $TARGET_DIR)"
  fi
  exit 0
fi

if $UNINSTALL; then
  TMUX_NOTIFY=0
  if [ -L "$HOOK_TARGET" ] && [[ "$(readlink "$HOOK_TARGET")" == "$HOOKS_SRC/"* ]]; then
    rm "$HOOK_TARGET"
    echo "  removed $HOOK_TARGET"
  fi
  echo "done (uninstalled)"
else
  echo "done (target: $TARGET_DIR)"
fi

if ! command -v jq >/dev/null; then
  echo "Warning: jq not found; Claude tmux hook settings unchanged." >&2
  exit 0
fi

CURRENT_NOTIFY=""
if [ -f "$SETTINGS_FILE" ] && jq -e . "$SETTINGS_FILE" >/dev/null 2>&1; then
  CURRENT_NOTIFY="$(jq -r '[.hooks[]?[]?.hooks[]?.command? // empty | select(endswith("tmux-notify.sh notify"))] | if length > 0 then "1" else "" end' "$SETTINGS_FILE")"
fi

if [ -z "$TMUX_NOTIFY" ]; then
  if [ -t 0 ]; then
    if [ "$CURRENT_NOTIFY" = 1 ]; then
      printf "tmux pane notifications are enabled. Disable? [y/N] "
      read -r answer
      case "$answer" in [yY]*) TMUX_NOTIFY=0 ;; *) TMUX_NOTIFY=1 ;; esac
    else
      printf "Enable Claude tmux pane notifications? [Y/n] "
      read -r answer
      case "$answer" in [nN]*) TMUX_NOTIFY=0 ;; *) TMUX_NOTIFY=1 ;; esac
    fi
  else
    TMUX_NOTIFY="${CURRENT_NOTIFY:-0}"
  fi
fi

if [ "$TMUX_NOTIFY" = 0 ] && [ ! -e "$HOOK_TARGET" ] && [ ! -f "$SETTINGS_FILE" ]; then
  exit 0
fi

if $UNINSTALL && [ ! -f "$SETTINGS_FILE" ]; then
  exit 0
fi

if ! $UNINSTALL; then
  mkdir -p "$HOOKS_DIR" "$(dirname "$SETTINGS_FILE")"
fi
if [ "$TMUX_NOTIFY" = 1 ]; then
  if [ -L "$HOOK_TARGET" ] && [ "$(readlink "$HOOK_TARGET")" = "$HOOKS_SRC/tmux-notify.sh" ]; then
    echo "  tmux-notify.sh (already linked)"
  elif [ -e "$HOOK_TARGET" ]; then
    echo "Warning: $HOOK_TARGET already exists; hooks not configured." >&2
    exit 0
  else
    ln -s "$HOOKS_SRC/tmux-notify.sh" "$HOOK_TARGET"
    echo "  tmux-notify.sh → $HOOKS_SRC/tmux-notify.sh"
  fi
elif [ -L "$HOOK_TARGET" ] && [[ "$(readlink "$HOOK_TARGET")" == "$HOOKS_SRC/"* ]]; then
  rm "$HOOK_TARGET"
  echo "  removed $HOOK_TARGET"
fi

[ -f "$SETTINGS_FILE" ] || printf '{}\n' >"$SETTINGS_FILE"
TEMP="$(mktemp "$(dirname "$SETTINGS_FILE")/settings.json.XXXXXX")"
trap 'rm -f "$TEMP"' EXIT

if ! jq --arg cmd "$HOME/.claude/hooks/tmux-notify.sh" --arg enabled "$TMUX_NOTIFY" '
  def strip_managed($managed):
    map(.hooks = [(.hooks // [])[] | select((.command? // "") != $managed)])
    | map(select((.hooks | length) > 0));
  .hooks = (if (.hooks | type) == "object" then .hooks else {} end)
  | .hooks.Stop = ((.hooks.Stop // [] | strip_managed($cmd + " notify"))
      + (if $enabled == "1" then [{"matcher":"","hooks":[{"type":"command","command":($cmd + " notify")}]}] else [] end))
  | .hooks.UserPromptSubmit = ((.hooks.UserPromptSubmit // [] | strip_managed($cmd + " clear"))
      + (if $enabled == "1" then [{"matcher":"","hooks":[{"type":"command","command":($cmd + " clear")}]}] else [] end))
  | if (.hooks.Stop | length) == 0 then del(.hooks.Stop) else . end
  | if (.hooks.UserPromptSubmit | length) == 0 then del(.hooks.UserPromptSubmit) else . end
  | if (.hooks | length) == 0 then del(.hooks) else . end
' "$SETTINGS_FILE" >"$TEMP"; then
  echo "Warning: $SETTINGS_FILE is invalid; hook settings unchanged." >&2
  exit 0
fi

mv "$TEMP" "$SETTINGS_FILE"
trap - EXIT
echo "updated $SETTINGS_FILE"
